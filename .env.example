# Copy to .env (never commit .env) and fill in. Keep comments on their own lines.

# ---- trader (cpp/build/hybrid_bot) ----
# Manifold: profile -> API key, and your user id (used for position reads)
MANIFOLD_API_KEY=
MANIFOLD_USER_ID=
# Kalshi: API key id (UUID) and the RSA private key file downloaded when you created it
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_FILE=kalshi_key.pem

# ---- control bot (control_bot.py) ----
# A dedicated Telegram bot from @BotFather, and the chat ids allowed to command it (required)
CONTROL_TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
CONTROL_CONFIG=config_websocket.yaml
CONTROL_TRADER_LOG=trader.log

# How /restart restarts the trader. Keep ONE of the two blocks.
# (a) tmux respawn loop (cpp/deploy/run_trader_cpp.sh):
CONTROL_RESTART_MODE=command
CONTROL_RESTART_COMMAND=pkill -f cpp/build/hybrid_bot
CONTROL_PROCESS_PATTERN=cpp/build/hybrid_bot
# (b) systemd user unit (cpp/deploy/manifold-bot-cpp.service):
# CONTROL_RESTART_MODE=systemd
# CONTROL_SERVICE_UNIT=manifold-bot-cpp.service
# CONTROL_PROCESS_PATTERN=cpp/build/hybrid_bot
